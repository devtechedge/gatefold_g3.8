# APP_URL: the base URL where this deployment is hosted.
# Used for self-referential links and metadata.
APP_URL="http://localhost:3000"

# GATEFOLD_TICKET_SECRET: secret used to sign and verify ticket QR codes.
# If omitted, the demo default secret is used. Set a strong value in any
# non-demo deployment.
GATEFOLD_TICKET_SECRET="change-me-in-production"
